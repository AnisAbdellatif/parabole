import { Theme } from "theme.slint";
import { Core } from "core.slint";

export component ListHeader inherits Rectangle {
    height: 58px;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 18px;
        padding-bottom: 12px;
        spacing: 10px;
        alignment: start;
        Text {
            text: Core.list-title;
            color: Theme.text;
            font-size: 20px;
            font-weight: Theme.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: Core.list-subtitle;
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}
