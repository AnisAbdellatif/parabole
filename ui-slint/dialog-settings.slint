import { ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogApi } from "dialog-api.slint";
import { DButton, DCheck, DField, FormRow, Segmented } from "dialog-kit.slint";
import { DialogBody, DialogFooter, DialogFrame } from "dialog-frame.slint";
import { AppearancePane } from "dialog-appearance.slint";
import { GuidesTab } from "dialog-guides.slint";

component PlaybackTab inherits VerticalLayout {
    spacing: 12px;
    FormRow { label: "Default player"; ComboBox { model: DialogApi.player-kinds; current-index <=> DialogApi.set-default; } }
    FormRow { label: "Live player"; ComboBox { model: DialogApi.player-kinds-opt; current-index <=> DialogApi.set-live; } }
    FormRow { label: "Movie player"; ComboBox { model: DialogApi.player-kinds-opt; current-index <=> DialogApi.set-movie; } }
    FormRow { label: "Episode player"; ComboBox { model: DialogApi.player-kinds-opt; current-index <=> DialogApi.set-episode; } }
    FormRow {
        label: "Live latency";
        VerticalLayout {
            spacing: 8px;
            padding-top: 5px;
            DCheck { text: "Low-latency buffering"; checked <=> DialogApi.set-low-latency; }
            DCheck { text: "Catch up to the live edge"; checked <=> DialogApi.set-catchup; }
            HorizontalLayout {
                spacing: 8px;
                DField { width: 60px; text <=> DialogApi.set-live-ok; }
                Text { text: "s behind still counts as live"; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; }
            }
        }
    }
}

component PlayersTab inherits VerticalLayout {
    spacing: 12px;
    FormRow { label: "mpv path"; DField { placeholder: "auto-detect"; text <=> DialogApi.set-mpv-path; } }
    FormRow { label: "VLC path"; DField { placeholder: "auto-detect"; text <=> DialogApi.set-vlc-path; } }
    FormRow {
        label: "";
        DButton { text: "Detect"; clicked => { DialogApi.settings-detect(); } }
        Text { text: DialogApi.set-detected; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
    }
    FormRow { label: "Custom command"; DField { placeholder: "{url} {title} {user_agent} {referrer}"; text <=> DialogApi.set-template; } }
    FormRow { label: "Extra mpv args"; DField { text <=> DialogApi.set-mpv-args; } }
}

component SportsTab inherits VerticalLayout {
    spacing: 12px;
    FormRow { label: "Sports tab"; DCheck { text: "Show the Sports tab"; checked <=> DialogApi.set-sports; } }
    if DialogApi.set-sports: FormRow {
        label: "Sports";
        VerticalLayout {
            spacing: 8px;
            padding-top: 5px;
            for sport[i] in DialogApi.sports-list: DCheck {
                text: sport.name;
                checked: sport.checked;
                changed checked => { DialogApi.sport-toggled(i); }
            }
        }
    }
    if DialogApi.set-sports: FormRow {
        label: "Languages";
        VerticalLayout {
            spacing: 8px;
            padding-top: 5px;
            for lang[i] in DialogApi.sports-langs: DCheck {
                text: lang.name;
                checked: lang.checked;
                changed checked => { DialogApi.sports-lang-toggled(i); }
            }
        }
    }
    Text {
        text: "Upcoming and live events of popular competitions, with the TV channels showing them. Data comes from 365scores and LiveScore (free, unofficial); channels are for information and may not be in your sources.";
        color: Theme.text-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

component ServicesTab inherits VerticalLayout {
    spacing: 12px;
    FormRow { label: "Details"; DCheck { text: "Fetch movie and series details from IMDb"; checked <=> DialogApi.set-imdb; } }
    Text {
        text: "Poster, rating and plot come from IMDb (free, unofficial), with Trakt as a fallback. Titles of what you open are sent to these services.";
        color: Theme.text-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    FormRow {
        label: "Trakt";
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            if DialogApi.trakt-state == 0: VerticalLayout {
                spacing: 6px;
                HorizontalLayout { alignment: start; DButton { text: "Connect"; clicked => { DialogApi.trakt-connect(); } } }
                Text { text: "Link your Trakt account to record what you watch."; color: Theme.text-dim; font-size: Theme.fs-sm; wrap: word-wrap; }
                if DialogApi.trakt-error != "": Text { text: DialogApi.trakt-error; color: Theme.error; font-size: Theme.fs-sm; wrap: word-wrap; }
            }
            if DialogApi.trakt-state == 1: VerticalLayout {
                spacing: 8px;
                Text { text: DialogApi.trakt-code; color: Theme.text; font-size: Theme.fs-lg * 1.5; font-weight: Theme.semibold; letter-spacing: 3px; }
                Text { text: "Enter this code at " + DialogApi.trakt-url; color: Theme.text-dim; font-size: Theme.fs-sm; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    DButton { text: "Open trakt.tv/activate"; clicked => { DialogApi.trakt-open(); } }
                    DButton { text: "Copy code"; clicked => { DialogApi.trakt-copy(); } }
                    DButton { text: "Cancel"; clicked => { DialogApi.trakt-cancel(); } }
                }
            }
            if DialogApi.trakt-state == 2: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: DialogApi.trakt-user != "" ? "Connected as @" + DialogApi.trakt-user : "Connected"; color: Theme.text; font-size: Theme.fs-md; vertical-alignment: center; }
                    DButton { text: "Disconnect"; clicked => { DialogApi.trakt-disconnect(); } }
                }
                DCheck { text: "Report what I watch"; checked <=> DialogApi.set-trakt-scrobble; }
                Text { text: "Playback progress and episodes you mark watched are sent to Trakt."; color: Theme.text-dim; font-size: Theme.fs-sm; wrap: word-wrap; }
            }
        }
    }
}

export component SettingsDialog inherits DialogFrame {
    title: "Settings";
    card-width: 560px;
    HorizontalLayout {
        padding: 16px;
        padding-bottom: 0px;
        tabs := Segmented {
            options: ["Playback", "Players", "Appearance", "Sports", "TV guides", "Services"];
            current: DialogApi.settings-tab;
            changed(i) => { DialogApi.settings-tab = i; }
        }
    }
    DialogBody {
        max-body: root.max-body - 48px;
        if DialogApi.settings-tab == 0: PlaybackTab { }
        if DialogApi.settings-tab == 1: PlayersTab { }
        if DialogApi.settings-tab == 2: AppearancePane { }
        if DialogApi.settings-tab == 3: SportsTab { }
        if DialogApi.settings-tab == 4: GuidesTab { }
    if DialogApi.settings-tab == 5: ServicesTab { }
    }
    if DialogApi.settings-tab != 2 && DialogApi.settings-tab != 4: DialogFooter {
        DButton { text: "Cancel"; clicked => { DialogApi.close(); } }
        DButton { text: "Save"; kind: 1; clicked => { DialogApi.settings-save(); } }
    }
    if DialogApi.settings-tab == 2 || DialogApi.settings-tab == 4: DialogFooter {
        Text { text: "Applied immediately"; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1; }
        DButton { text: "Done"; clicked => { DialogApi.close(); } }
    }
}
