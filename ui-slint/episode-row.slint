// One 48px episode row of the series page: number, title, progress, play and watched buttons.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";
import { EpisodeItem } from "types.slint";

export component EpisodeRow inherits Rectangle {
    in property <EpisodeItem> ep;
    in property <int> index;
    in property <bool> current;
    callback activated();
    callback watched-toggled();
    callback picked();
    accessible-role: list-item;
    accessible-label: root.ep.num + " " + root.ep.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    accessible-item-index: root.index;
    accessible-action-default => { root.activated(); }
    height: 48px;
    Rectangle {
        x: 0px;
        y: 0px;
        height: 44px;
        border-radius: Theme.radius-l;
        border-width: 1px;
        background: ep-ta.has-hover || root.current ? Theme.row-hover : transparent;
        border-color: root.current ? Theme.border : transparent;
        Text { x: 14px; width: 44px; text: root.ep.num; color: Theme.text-muted; font-size: Theme.fs-sm; font-weight: Theme.semibold; vertical-alignment: center; height: parent.height; }
        // play and watched slots stay reserved so the title width never jumps
        Text { x: 68px; width: parent.width - 150px; text: root.ep.title; color: Theme.text; font-size: Theme.fs-md; vertical-alignment: center; height: parent.height; overflow: elide; }
        if root.ep.progress > 0 && !root.ep.watched: Rectangle {
            x: 10px;
            y: parent.height - 3px;
            width: parent.width - 20px;
            height: 3px;
            background: #00000096;
            Rectangle { x: 0px; width: parent.width * root.ep.progress; background: Theme.accent; }
        }
        ep-ta := TouchArea {
            clicked => { root.picked(); }
            double-clicked => { root.activated(); }
            // nested so hovering the buttons keeps the row hovered
            if ep-ta.has-hover || root.current: play := TouchArea {
                x: parent.width - 74px;
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                accessible-role: button;
                accessible-label: "Play";
                accessible-action-default => { root.activated(); }
                clicked => { root.activated(); }
                Icon { source: Icons.play; size: 16px; x: 8px; y: 8px; tint: play.has-hover ? Theme.accent : Theme.text; }
            }
            if root.ep.watched || ep-ta.has-hover: TouchArea {
                x: parent.width - 38px;
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                accessible-role: button;
                accessible-label: root.ep.watched ? "Mark as unwatched" : "Mark as watched";
                accessible-action-default => { root.watched-toggled(); }
                clicked => { root.watched-toggled(); }
                Icon { source: Icons.check; size: 16px; x: 8px; y: 8px; tint: root.ep.watched ? Theme.accent : Theme.text-muted; }
            }
        }
    }
}
