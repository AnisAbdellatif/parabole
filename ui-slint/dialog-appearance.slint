// Appearance dialog (spec S2c): edits AppearanceApi, Rust applies live and persists.
import { Slider, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DialogFrame, FormRow } from "dialog-kit.slint";

export global AppearanceApi {
    in property <[color]> swatches;
    in-out property <int> accent;
    in-out property <int> mode;
    in-out property <int> density;
    in-out property <float> radius: 1.0;
    in-out property <float> font: 1.0;
    in-out property <bool> reduce-motion;
    callback changed();
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback picked(int);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: Theme.radius - 2px;
            background: i == root.current ? Theme.selected-bg : ta.has-hover ? Theme.surface-hover : transparent;
            Text {
                text: o;
                color: i == root.current ? Theme.accent : Theme.text-muted;
                font-size: Theme.fs-md;
                font-weight: Theme.medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea { clicked => { root.picked(i); } }
        }
    }
}

export component AppearanceDialog inherits DialogFrame {
    title: "Appearance";
    card-width: 480px;
    FormRow {
        label: "Accent";
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            for c[i] in AppearanceApi.swatches: Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                border-width: 2px;
                border-color: i == AppearanceApi.accent ? Theme.text : transparent;
                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: c; }
                swatch := TouchArea { clicked => { AppearanceApi.accent = i; AppearanceApi.changed(); } }
            }
        }
    }
    FormRow {
        label: "Mode";
        Segmented { options: ["Dark", "OLED", "Light"]; current: AppearanceApi.mode; picked(i) => { AppearanceApi.mode = i; AppearanceApi.changed(); } }
    }
    FormRow {
        label: "Density";
        Segmented { options: ["Compact", "Cozy", "TV"]; current: AppearanceApi.density; picked(i) => { AppearanceApi.density = i; AppearanceApi.changed(); } }
    }
    FormRow {
        label: "Corner radius";
        Slider { minimum: 0.5; maximum: 1.5; value <=> AppearanceApi.radius; changed(v) => { AppearanceApi.changed(); } }
    }
    FormRow {
        label: "Font size";
        Slider { minimum: 0.85; maximum: 1.3; value <=> AppearanceApi.font; changed(v) => { AppearanceApi.changed(); } }
    }
    FormRow {
        label: "Motion";
        motion-switch := Switch { text: "Reduce motion"; checked <=> AppearanceApi.reduce-motion; toggled => { AppearanceApi.changed(); } }
    }
}
