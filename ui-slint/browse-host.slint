// Center area: list header + list / poster grid / empty state, or the series page; details overlay on top.
// Owned by the browse area.
import { Theme } from "theme.slint";
import { Core } from "core.slint";
import { BrowseApi } from "browse-api.slint";
import { ListHeader } from "list-header.slint";
import { StreamList } from "stream-list.slint";
import { PosterGrid } from "browse-grid.slint";
import { Skeleton } from "skeleton.slint";
import { EmptyState } from "browse-empty.slint";
import { SeriesPage } from "browse-series.slint";
import { DetailsPanel } from "browse-details.slint";
import { Hero } from "browse-hero.slint";

export component BrowseHost inherits Rectangle {
    callback interacted();
    property <length> full-h: max(190px, root.height * 0.42);
    property <bool> hero-on: !BrowseApi.series-open && Core.streams.length > 0;
    property <bool> collapsed: false;
    property <length> sy: BrowseApi.scroll-y;
    // collapse only when the list is long enough that the freed space can't clamp the scroll back to 0
    changed sy => {
        if (root.sy > 40px && BrowseApi.scroll-room > root.full-h + 40px) { root.collapsed = true; }
        else if (root.sy < 4px) { root.collapsed = false; }
    }
    // animated; the hero sits outside the layout so its height can follow root.height without a binding loop
    property <length> hero-h: (root.hero-on && !root.collapsed) ? root.full-h : 0px;
    animate hero-h { duration: Theme.motion * 1.5; easing: ease-in-out; }
    if root.hero-on: Hero { x: 0px; y: 0px; width: root.width; height: root.hero-h; }
    VerticalLayout {
        y: root.hero-h;
        height: root.height - root.hero-h;
        if BrowseApi.series-open: SeriesPage { }
        if !BrowseApi.series-open: ListHeader { }
        if !BrowseApi.series-open && Core.streams.length > 0 && !BrowseApi.grid-view: StreamList { interacted => { root.interacted(); } }
        if !BrowseApi.series-open && Core.streams.length > 0 && BrowseApi.grid-view: PosterGrid { interacted => { root.interacted(); } }
        if !BrowseApi.series-open && Core.streams.length == 0 && Core.syncing: Skeleton { }
        if !BrowseApi.series-open && Core.streams.length == 0 && !Core.syncing: EmptyState { }
    }
    if BrowseApi.details-open: DetailsPanel { }
}
