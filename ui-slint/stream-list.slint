import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Core } from "core.slint";
import { StreamRow } from "stream-row.slint";

// Virtualized: the Rust model is lazy, so only visible rows are ever built.
export component StreamList inherits Rectangle {
    callback interacted();
    in property <int> cursor: Core.cursor;

    function ensure-visible(i: int) {
        if (-list.viewport-y > i * Theme.channel-row-step) {
            list.viewport-y = -i * Theme.channel-row-step;
        } else if (-list.viewport-y + list.visible-height < (i + 1) * Theme.channel-row-step) {
            list.viewport-y = -((i + 1) * Theme.channel-row-step - list.visible-height);
        }
    }
    changed cursor => { root.ensure-visible(root.cursor); }

    list := ListView {
        x: 24px;
        width: parent.width - 48px;
        height: parent.height;
        for item[i] in Core.streams: Rectangle {
            height: Theme.channel-row-step;
            StreamRow {
                y: 0px;
                width: parent.width;
                item: item;
                cursor: i == Core.cursor;
                playing: Core.playing-title != "" && item.name == Core.playing-title;
                clicked => { Core.cursor = i; root.interacted(); }
                double-clicked => { Core.cursor = i; Core.stream-activated(i); }
                favorite-clicked => { Core.favorite-toggled(i); root.interacted(); }
            }
        }
    }
    if Core.streams.length == 0: Text {
        text: Core.empty-text;
        color: Theme.text-muted;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 48px;
    }
}
