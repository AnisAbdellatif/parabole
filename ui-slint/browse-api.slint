// Browse area state and callbacks (poster grid, series, details, menus, edit mode). Owned by the browse area.
import { Core } from "core.slint";
import { ChipItem, MenuEntry, SideRow, EditCat, EditGroup, GridRow, EpisodeItem, InfoView, HeroExtra, GuideItem } from "types.slint";

export global BrowseApi {
    // Tried after DialogApi and PlayerApi; return true when handled.
    callback key(KeyEvent) -> bool;
    key(e) => {
        if (e.modifiers.meta || e.modifiers.control) {
            if (e.text == "d" && !root.series-open && Core.streams.length > 0) {
                Core.favorite-toggled(Core.cursor);
                return true;
            }
            if (e.text == Key.LeftArrow && Core.has-sources) { root.sidebar-focus = true; return true; }
            if (e.text == Key.RightArrow) { root.sidebar-focus = false; return true; }
            return false;
        }
        if (root.guide-open) {
            if (e.text == Key.Escape) { if (root.guide-picking) { root.guide-pick-cancel(); } else { root.guide-closed(); } }
            if (root.guide-picking) { return e.text == Key.Escape; }
            return e.text == Key.Escape || e.text == Key.Return || e.text == Key.UpArrow || e.text == Key.DownArrow;
        }
        if (root.details-open) {
            if (e.text == Key.Escape) { root.details-closed(); }
            return e.text == Key.Escape || e.text == Key.Return || e.text == Key.UpArrow || e.text == Key.DownArrow;
        }
        if (root.sidebar-focus && !root.edit-on) {
            if (e.text == Key.DownArrow) { root.sidebar-step(1); return true; }
            if (e.text == Key.UpArrow) { root.sidebar-step(-1); return true; }
            if (e.text == Key.Return || e.text == Key.RightArrow) { root.sidebar-focus = false; return true; }
        }
        if (root.series-open) {
            if (e.text == Key.Escape) { root.series-back(); return true; }
            let last = max(0, root.episodes.length - 1);
            if (e.text == Key.UpArrow) { root.episode-cursor = max(0, root.episode-cursor - 1); return true; }
            if (e.text == Key.DownArrow) { root.episode-cursor = min(last, root.episode-cursor + 1); return true; }
            if (e.text == Key.PageUp) { root.episode-cursor = max(0, root.episode-cursor - 8); return true; }
            if (e.text == Key.PageDown) { root.episode-cursor = min(last, root.episode-cursor + 8); return true; }
            if (e.text == Key.Home) { root.episode-cursor = 0; return true; }
            if (e.text == Key.End) { root.episode-cursor = last; return true; }
            if (e.text == Key.Return) {
                if (root.episodes.length > 0) { root.episode-activated(root.episode-cursor); }
                return true;
            }
            return false;
        }
        if (root.grid-view && Core.streams.length > 0) {
            if (e.text == Key.LeftArrow) { Core.cursor = max(0, Core.cursor - 1); return true; }
            if (e.text == Key.RightArrow) { Core.cursor = min(Core.streams.length - 1, Core.cursor + 1); return true; }
            if (e.text == Key.UpArrow) { Core.cursor = max(0, Core.cursor - root.grid-cols); return true; }
            if (e.text == Key.DownArrow) { Core.cursor = min(Core.streams.length - 1, Core.cursor + root.grid-cols); return true; }
            if (e.text == Key.PageUp) { Core.cursor = max(0, Core.cursor - 3 * root.grid-cols); return true; }
            if (e.text == Key.PageDown) { Core.cursor = min(Core.streams.length - 1, Core.cursor + 3 * root.grid-cols); return true; }
        }
        return false;
    }
    // Asks the orchestrator-wired dialog layer to open "sources" or "group".
    callback request-dialog(string);

    in property <bool> grid-view;
    in property <bool> sort-visible;
    in property <string> sort-label;
    in property <[MenuEntry]> sort-items;
    in property <[ChipItem]> chips;
    in property <[MenuEntry]> row-menu;

    // Context for the group dialog (id -1 = create), copied to DialogApi by slint_ui/wiring.rs.
    in property <int> group-ctx-id: -1;
    in property <string> group-ctx-name;

    callback sort-picked(string);
    callback chip-clicked(string);
    callback row-menu-requested(int);
    callback row-menu-picked(string);

    // Sidebar.
    in property <[SideRow]> side-rows;
    in property <[MenuEntry]> side-menu;
    in property <int> side-scroll-index;
    in property <int> side-scroll-tick;
    in-out property <bool> sidebar-focus: false;
    in-out property <string> side-filter;
    in-out property <length> sidebar-w: 260px;
    callback side-menu-requested(string);
    callback side-menu-picked(string);
    callback pin-toggled(string);
    callback group-new();
    callback sidebar-step(int);
    callback side-filter-edited(string);
    // Enter in the filter field: select the first matching row.
    callback side-filter-accepted();

    // Edit mode.
    in property <bool> edit-on: false;
    in property <string> edit-hint;
    in property <bool> edit-can-reorder: false;
    in property <[EditCat]> edit-cats;
    in property <[EditGroup]> edit-groups;
    in property <bool> edit-has-filter: false;
    in property <bool> hide-new: false;
    in property <bool> hide-new-available: false;
    in-out property <string> edit-filter;
    callback edit-toggled();
    callback edit-hide(int);
    callback edit-pin(int);
    callback edit-move(int, int);
    callback edit-bulk(string);
    callback edit-filter-edited(string);
    callback hide-new-toggled(bool);
    callback edit-group-move(int, int);
    callback edit-group-rename(int);
    callback edit-group-delete(int);

    // Hero banner: focus is the cursor row or the hovered tile (hover-index -1 = none).
    in property <HeroExtra> hero;
    in-out property <int> hover-index: -1;
    in-out property <length> scroll-y;
    in-out property <length> scroll-room;
    callback hero-focused(int);
    callback hero-details(int);

    // Poster grid.
    in property <[GridRow]> grid-rows;
    in-out property <int> grid-cols: 1;
    callback grid-cols-changed(int);
    callback tile-hide-toggled(int);

    // Empty / error state shown instead of an empty list.
    in property <string> empty-title;
    in property <string> empty-body;
    in property <string> empty-cta;
    in property <bool> empty-busy: false;
    callback empty-cta-clicked();

    // Series page.
    in property <bool> series-open: false;
    in property <string> series-title;
    in property <bool> series-loading: false;
    in property <bool> series-empty: false;
    in property <string> season-label;
    in property <[MenuEntry]> season-items;
    in property <[EpisodeItem]> episodes;
    in-out property <int> episode-cursor: 0;
    in property <InfoView> series-info;
    callback series-back();
    callback season-picked(string);
    callback episode-activated(int);
    callback episode-watched-toggled(int);

    // Details window ("Info…" in the row menu).
    in property <bool> details-open: false;
    in property <string> details-title;
    in property <InfoView> details;
    callback details-closed();
    in property <bool> guide-open: false;
    in property <string> guide-title;
    in property <[GuideItem]> guide;
    in property <int> guide-scroll-to: 0;
    callback guide-closed();
    // Manual channel link: Rust sets picking/has-link/hits; query is cleared by Rust on start.
    in property <bool> guide-picking: false;
    in property <bool> guide-has-link: false;
    in-out property <string> guide-query;
    in property <[string]> guide-hits;
    callback guide-pick-start();
    callback guide-pick-cancel();
    callback guide-auto();
    callback guide-query-edited(string);
    callback guide-hit-picked(int);
    callback details-retry();
}
