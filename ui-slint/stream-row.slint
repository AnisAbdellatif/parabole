import { Theme } from "theme.slint";
import { StreamItem } from "types.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";
import { LogoTile } from "logo-tile.slint";

// One 62px Live channel row (see src/ui/stream_row.rs).
export component StreamRow inherits Rectangle {
    in property <StreamItem> item;
    in property <bool> cursor;
    in property <bool> playing;
    callback clicked();
    callback double-clicked();
    callback favorite-clicked();

    height: Theme.channel-row-h;
    border-radius: Theme.radius-l;
    border-width: 1px;
    background: root.playing ? Theme.selected-bg : (root.cursor || row-area.has-hover) ? Theme.row-hover : transparent;
    border-color: root.playing ? Theme.selected-border : root.cursor ? Theme.border : transparent;
    opacity: (root.item.missing || root.item.hidden) ? 0.5 : 1;

    row-area := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    LogoTile {
        x: 10px;
        y: (parent.height - self.height) / 2;
        initials: root.item.initials;
        logo: root.item.logo;
        has-logo: root.item.has-logo;
    }
    Text {
        x: 68px;
        y: root.item.meta == "" ? (parent.height - self.height) / 2 : 12px;
        width: parent.width - 68px - 76px;
        text: root.item.name;
        color: Theme.text;
        font-size: 14px;
        font-weight: Theme.medium;
        overflow: elide;
    }
    if root.item.meta != "": Text {
        x: 68px;
        y: 33px;
        width: parent.width - 68px - 76px;
        text: root.item.meta;
        color: Theme.text-muted;
        font-size: 12px;
        overflow: elide;
    }
    if root.item.watched: Rectangle {
        x: parent.width - 76px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #000000aa;
        Icon { source: Icons.check; tint: Theme.accent; size: 14px; x: 2px; y: 2px; }
    }
    star := TouchArea {
        x: parent.width - 38px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        clicked => { root.favorite-clicked(); }
        Icon {
            source: root.item.favorite ? Icons.star-filled : Icons.star;
            tint: root.item.favorite ? Theme.star : Theme.text-muted;
            size: 18px;
            x: 7px;
            y: 7px;
        }
    }
    if root.item.progress > 0 && !root.item.watched: Rectangle {
        x: 10px;
        y: parent.height - 3px;
        width: parent.width - 20px;
        height: 3px;
        background: #00000096;
        Rectangle {
            x: 0px;
            width: parent.width * root.item.progress;
            background: Theme.accent;
        }
    }
}
