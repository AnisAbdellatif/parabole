// Control bar drawn over the video (pane, fullscreen and mini share it).
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { PlayerApi } from "player-api.slint";
import { IconBtn, Bar, TrackMenu } from "player-widgets.slint";

export component PlayerControls inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> docked: false;
    out property <bool> hovered: bg.has-hover;
    height: 44px;
    background: #000000b8;
    bg := TouchArea { }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;
        IconBtn {
            icon: PlayerApi.paused ? Icons.play : Icons.pause;
            clicked => { PlayerApi.toggle-pause(); }
        }
        IconBtn { icon: Icons.stop; clicked => { PlayerApi.stop(); } }
        IconBtn {
            icon: PlayerApi.muted ? Icons.volume-off : Icons.volume;
            clicked => { PlayerApi.toggle-mute(); }
        }
        if !root.compact: Bar {
            width: 80px;
            frac: PlayerApi.volume / 130;
            changed(f) => { PlayerApi.set-volume(f); }
        }
        if !root.compact && !PlayerApi.is-live && PlayerApi.duration > 0: Text {
            text: PlayerApi.pos-text;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        if !root.compact && !PlayerApi.is-live && PlayerApi.duration > 0: Bar {
            horizontal-stretch: 1;
            frac: PlayerApi.position / PlayerApi.duration;
            changed(f) => { PlayerApi.seek(f); }
        }
        if !root.compact && !PlayerApi.is-live && PlayerApi.duration > 0: Text {
            text: PlayerApi.dur-text;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.compact: TrackMenu {
            icon: Icons.subtitles;
            tracks: PlayerApi.sub-tracks;
            off-marks-on: true;
            picked(id) => { PlayerApi.select-sub(id); }
        }
        if !root.compact: TrackMenu {
            icon: Icons.audio;
            tracks: PlayerApi.audio-tracks;
            picked(id) => { PlayerApi.select-audio(id); }
        }
        if !root.compact && PlayerApi.is-live: IconBtn { icon: Icons.live; clicked => { PlayerApi.go-live(); } }
        if !root.compact: IconBtn { icon: Icons.info; on: PlayerApi.show-stats; clicked => { PlayerApi.toggle-stats(); } }
        IconBtn { icon: Icons.mini; on: PlayerApi.mini; clicked => { PlayerApi.toggle-mini(); } }
        if !PlayerApi.mini: IconBtn {
            icon: PlayerApi.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
            clicked => { PlayerApi.toggle-fullscreen(); }
        }
        if root.docked: IconBtn {
            icon: PlayerApi.dock-bottom ? Icons.dock-right : Icons.dock-bottom;
            clicked => { PlayerApi.toggle-dock(); }
        }
    }
}
