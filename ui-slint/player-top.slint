// Top scrim over the video: LIVE/VOD chip, title and tech info.
import { Theme } from "theme.slint";
import { PlayerApi } from "player-api.slint";

export component TopChrome inherits Rectangle {
    height: 64px;
    background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;
        Rectangle {
            visible: PlayerApi.tag != "";
            width: PlayerApi.tag != "" ? chip.preferred-width + 16px : 0px;
            height: 22px;
            border-radius: 6px;
            background: PlayerApi.is-live ? #dc2626 : #ffffff26;
            chip := Text {
                text: PlayerApi.is-live ? "● " + PlayerApi.tag : PlayerApi.tag;
                color: white;
                font-size: Theme.fs-xs;
                font-weight: Theme.semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: PlayerApi.title;
            color: white;
            font-size: Theme.fs-md;
            font-weight: Theme.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: PlayerApi.tech != "" ? "· " + PlayerApi.tech : "";
            color: #cbd5e1;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
