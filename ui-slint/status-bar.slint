import { Theme } from "theme.slint";
import { Core } from "core.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";

export component StatusBar inherits Rectangle {
    height: Theme.statusbar-h;
    background: Theme.panel;
    Rectangle { y: 0px; height: 1px; background: Theme.divider; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Core.syncing ? Theme.warn : Theme.ok;
        }
        Text { text: Core.status-sources; color: Theme.text-muted; font-size: Theme.fs-sm; vertical-alignment: center; }
        Text { text: Core.status-items; color: Theme.text-muted; font-size: Theme.fs-sm; vertical-alignment: center; }
        if Core.playing-title != "": Text {
            text: "Playing: " + Core.playing-title + " in " + Core.playing-kind;
            color: Theme.text;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        if Core.playing-title != "": Rectangle {
            width: 60px;
            height: 22px;
            border-radius: 6px;
            background: stop.has-hover ? Theme.surface-hover : Theme.surface;
            stop := TouchArea { clicked => { Core.stop-playback(); } }
            Icon { x: 8px; source: Icons.stop; size: 12px; tint: Theme.text; }
            Text { x: 26px; height: parent.height; text: "Stop"; color: Theme.text; font-size: Theme.fs-sm; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
