// Row structs shared by Rust models and components.
export struct StreamItem {
    name: string,
    meta: string,
    initials: string,
    logo: image,
    has-logo: bool,
    favorite: bool,
    progress: float,
    watched: bool,
    missing: bool,
    hidden: bool,
}

// kind: 0 section header, 1 special entry, 2 group, 3 category. icon: 0 none, 1 star, 2 recent, 3 resume.
export struct SidebarItem {
    id: string,
    kind: int,
    label: string,
    count: int,
    icon: int,
}

export struct ToastItem {
    id: int,
    text: string,
}

// account-level: 0 normal, 1 warning (expiring / connections full), 2 error (expired).
export struct SourceRow {
    id: int,
    name: string,
    kind: string,
    refreshed: string,
    refreshing: bool,
    error: string,
    account: string,
    account-level: int,
    xtream: bool,
    checking: bool,
    confirm: bool,
}

export struct ProfileRow {
    id: int,
    name: string,
    renaming: bool,
    confirm: bool,
    can-delete: bool,
    others: [string],
}

// Player track-menu row. id -1 = "off" (subtitles only).
export struct TrackItem {
    id: int,
    label: string,
    selected: bool,
}
