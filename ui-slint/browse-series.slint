import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";
import { BrowseApi } from "browse-api.slint";
import { ContextMenu } from "browse-menu.slint";
import { InfoBody } from "browse-details.slint";
import { EmptyBox } from "browse-empty.slint";

// Series page: back button, provider details, season picker and episode list (see src/ui/series_view.rs).
export component SeriesPage inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 18px;
        padding-bottom: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: 30px;
            spacing: 14px;
            alignment: start;
            Rectangle {
                width: 86px;
                border-radius: 15px;
                border-width: 1px;
                border-color: Theme.border;
                background: back-ta.has-hover ? Theme.surface-hover : Theme.surface;
                back-ta := TouchArea { clicked => { BrowseApi.series-back(); } }
                Icon { source: Icons.back; size: 14px; x: 14px; y: 8px; }
                Text { x: 34px; text: "Back"; color: Theme.text; font-size: Theme.fs-md; font-weight: Theme.semibold; vertical-alignment: center; height: parent.height; }
            }
            Text { text: BrowseApi.series-title; color: Theme.text; font-size: Theme.fs-xl; font-weight: Theme.semibold; vertical-alignment: center; overflow: elide; }
        }
        if BrowseApi.series-info.state == 2: Rectangle {
            height: min(info.preferred-height, 230px);
            clip: true;
            info := InfoBody { info: BrowseApi.series-info; }
        }
        if BrowseApi.series-loading: Text { text: "Loading episodes…"; color: Theme.text-muted; font-size: Theme.fs-md; }
        if BrowseApi.series-empty: EmptyBox {
            title: "No episodes found";
            body: "This series has no episodes from the provider yet.";
            cta: "Back";
            clicked => { BrowseApi.series-back(); }
        }
        if !BrowseApi.series-loading && !BrowseApi.series-empty: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                height: 32px;
                alignment: start;
                season-btn := Rectangle {
                    width: season-text.preferred-width + 28px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: season-ta.has-hover ? Theme.surface-hover : Theme.surface;
                    season-ta := TouchArea {
                        clicked => { menu.open(season-btn.absolute-position.x, season-btn.absolute-position.y + season-btn.height + 4px); }
                    }
                    season-text := Text { x: 12px; text: BrowseApi.season-label + " ▾"; color: Theme.text; font-size: Theme.fs-md; vertical-alignment: center; height: parent.height; }
                }
            }
            ListView {
                for ep[i] in BrowseApi.episodes: Rectangle {
                    height: 48px;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 44px;
                        border-radius: Theme.radius-l;
                        background: ep-ta.has-hover ? Theme.row-hover : transparent;
                        ep-ta := TouchArea { double-clicked => { BrowseApi.episode-activated(i); } }
                        Text { x: 14px; width: 44px; text: ep.num; color: Theme.text-muted; font-size: Theme.fs-sm; font-weight: Theme.semibold; vertical-alignment: center; height: parent.height; }
                        Text { x: 68px; width: parent.width - 118px; text: ep.title; color: Theme.text; font-size: Theme.fs-md; vertical-alignment: center; height: parent.height; overflow: elide; }
                        if ep.progress > 0 && !ep.watched: Rectangle {
                            x: 10px;
                            y: parent.height - 3px;
                            width: parent.width - 20px;
                            height: 3px;
                            background: #00000096;
                            Rectangle { x: 0px; width: parent.width * ep.progress; background: Theme.accent; }
                        }
                        if ep.watched || ep-ta.has-hover: TouchArea {
                            x: parent.width - 38px;
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            clicked => { BrowseApi.episode-watched-toggled(i); }
                            Icon { source: Icons.check; size: 16px; x: 8px; y: 8px; tint: ep.watched ? Theme.accent : Theme.text-muted; }
                        }
                    }
                }
            }
        }
    }
    menu := ContextMenu {
        items: BrowseApi.season-items;
        menu-width: 200px;
        picked(id) => { BrowseApi.season-picked(id); }
    }
}
