import { Theme } from "theme.slint";
import { DialogApi } from "dialog-api.slint";
import { DButton, DField } from "dialog-kit.slint";
import { DialogBody, DialogFooter, DialogFrame } from "dialog-frame.slint";

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface-hover : transparent;
    Text { x: 10px; text: root.text; color: root.danger ? Theme.error : Theme.text; font-size: Theme.fs-md; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component ProfileItem inherits Rectangle {
    in property <int> id;
    in property <string> name;
    in property <bool> active;
    in property <bool> renaming;
    in property <bool> confirm;
    in property <bool> can-delete;
    in property <[string]> others;
    height: 48px;
    background: Theme.surface;
    border-radius: Theme.radius;
    menu := PopupWindow {
        x: root.width - 252px;
        y: root.height;
        width: 240px;
        Rectangle { background: Theme.toast-bg; border-radius: Theme.radius; border-width: 1px; border-color: Theme.toast-border; }
        VerticalLayout {
            padding: 4px;
            MenuItem { text: "Duplicate"; clicked => { DialogApi.profile-duplicate(root.id); } }
            if root.others.length > 0: HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                Text { text: "Copy favorites from"; color: Theme.text-dim; font-size: Theme.fs-sm; vertical-alignment: bottom; }
            }
            for n[i] in root.others: MenuItem { text: n; clicked => { DialogApi.profile-copy-favorites(root.id, i); } }
            if root.can-delete: MenuItem { text: "Delete"; danger: true; clicked => { DialogApi.profile-delete(root.id); } }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;
        cross-axis-alignment: center;
        if root.renaming: DField {
            text <=> DialogApi.profile-rename-text;
            horizontal-stretch: 1;
            accepted => { DialogApi.profile-rename-save(root.id); }
        }
        if root.renaming: DButton { text: "Save"; kind: 1; clicked => { DialogApi.profile-rename-save(root.id); } }
        if root.renaming: DButton { text: "Cancel"; clicked => { DialogApi.profile-rename-cancel(); } }
        if !root.renaming: HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: start;
            Text { text: root.name; color: Theme.text; font-size: Theme.fs-md; font-weight: Theme.semibold; vertical-alignment: center; overflow: elide; }
            if root.active: Rectangle {
                height: 20px;
                width: badge.preferred-width + 14px;
                border-radius: 10px;
                background: Theme.selected-bg;
                badge := Text { text: "Active"; color: Theme.accent; font-size: Theme.fs-sm; font-weight: Theme.medium; }
            }
        }
        if !root.renaming && root.confirm: DButton { text: "Really delete"; kind: 2; clicked => { DialogApi.profile-delete(root.id); } }
        if !root.renaming && root.confirm: DButton { text: "Cancel"; clicked => { DialogApi.profile-delete-cancel(); } }
        if !root.renaming && !root.confirm && !root.active: switch := DButton { text: "Switch"; clicked => { DialogApi.profile-switch(root.id); } }
        if !root.renaming && !root.confirm: DButton { text: "Rename"; clicked => { DialogApi.profile-rename-start(root.id); } }
        if !root.renaming && !root.confirm: DButton { text: "⋯"; clicked => { menu.show(); } }
    }
}

export component ProfilesDialog inherits DialogFrame {
    title: "Profiles";
    card-width: 600px;
    DialogBody {
        max-body: root.max-body;
        for p in DialogApi.profile-rows: ProfileItem {
            id: p.id; name: p.name; active: p.active; renaming: p.renaming; confirm: p.confirm;
            can-delete: p.can-delete; others: p.others;
        }
    }
    DialogFooter {
        DField { placeholder: "New profile name"; text <=> DialogApi.profile-new-name; horizontal-stretch: 1; accepted => { DialogApi.profile-create(); } }
        DButton { text: "Create"; kind: 1; enabled: DialogApi.profile-new-name != ""; clicked => { DialogApi.profile-create(); } }
    }
}
