// Dropdown pill: label + chevron. With `options` it shows its own list, else it only emits `clicked`.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";

export component DropPill inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <int> current: -1;
    in property <length> max-label-w: 200px;
    callback clicked();
    callback picked(int);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.options.length > 0) { popup.show(); } else { root.clicked(); } }
    height: 32px;
    width: min(label-text.preferred-width, root.max-label-w) + 42px;
    background: ta.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    ta := TouchArea {
        clicked => {
            if (root.options.length > 0) { popup.show(); } else { root.clicked(); }
        }
    }
    label-text := Text {
        x: 12px;
        width: min(self.preferred-width, root.max-label-w);
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-size: Theme.fs-md;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 22px;
        height: parent.height;
        text: "▾";
        color: Theme.text-muted;
        font-size: Theme.fs-md;
        vertical-alignment: center;
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 200px);
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    accessible-role: list-item;
                    accessible-label: o;
                    accessible-checkable: true;
                    accessible-checked: i == root.current;
                    accessible-action-default => { root.picked(i); }
                    height: 30px;
                    border-radius: 6px;
                    background: row.has-hover ? Theme.surface-hover : transparent;
                    if i == root.current: Icon { x: 8px; y: 7px; source: Icons.check; size: 16px; tint: Theme.accent; }
                    Text {
                        x: 30px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: o;
                        color: i == root.current ? Theme.accent : Theme.text;
                        font-size: Theme.fs-md;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row := TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}
