import { Theme } from "theme.slint";
import { Core } from "core.slint";

export component Tabs inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.border;
    height: 36px;
    width: 3 * 74px + 6px;
    HorizontalLayout {
        padding: 3px;
        for label[i] in ["Live", "Movies", "Series"]: Rectangle {
            border-radius: 7px;
            background: Core.tab == i ? Theme.accent : (ta.has-hover ? Theme.row-hover : transparent);
            ta := TouchArea { clicked => { Core.tab-selected(i); } }
            Text {
                text: label;
                color: Core.tab == i ? Theme.on-accent : Theme.text-muted;
                font-size: Theme.fs-md;
                font-weight: Theme.semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
