// Sports tab: event list on the left, "where is it on TV" panel on the right.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SportsRow, SportsChannel } from "types.slint";
import { SportsApi } from "sports-api.slint";
import { DButton, Segmented } from "dialog-kit.slint";
import { Icons } from "icons.slint";
import { Icon } from "icon.slint";

// Two-line match row (home over away, scores stacked; a single event has `away` empty and shows one centred line), under a competition band when `item.section` is set.
component MatchRow inherits Rectangle {
    in property <SportsRow> item;
    in property <bool> selected;
    callback clicked();
    callback reveal(length, length);
    changed selected => { if (root.selected) { root.reveal(root.y, root.height); } }
    accessible-role: list-item;
    accessible-label: root.item.away == "" ? root.item.home : root.item.home + " vs " + root.item.away;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    VerticalLayout {
        if root.item.section != "": Rectangle {
            height: 40px * Theme.density;
            Rectangle {
                y: 8px * Theme.density;
                height: parent.height - self.y - 2px;
                border-radius: Theme.radius;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.item.section;
                        font-size: Theme.fs-sm;
                        font-weight: Theme.semibold;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        Rectangle {
            height: 48px * Theme.density;
            border-radius: Theme.radius;
            background: root.selected ? Theme.selected-bg : ta.has-hover ? Theme.row-hover : transparent;
            border-width: 1px;
            border-color: root.selected ? Theme.selected-border : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                alignment: stretch;
                Text {
                    width: 56px;
                    text: root.item.time;
                    font-size: Theme.fs-md;
                    color: root.item.live ? Theme.live-fg : Theme.text-muted;
                    font-weight: root.item.live ? Theme.semibold : Theme.regular;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    Text { text: root.item.home; font-size: Theme.fs-md; color: Theme.text; overflow: elide; }
                    if root.item.away != "": Text { text: root.item.away; font-size: Theme.fs-md; color: Theme.text; overflow: elide; }
                }
                if root.item.live && root.item.away != "": VerticalLayout {
                    width: 24px;
                    alignment: center;
                    spacing: 3px;
                    Text { text: root.item.home-score; font-size: Theme.fs-md; font-weight: Theme.semibold; color: Theme.live-fg; horizontal-alignment: right; }
                    Text { text: root.item.away-score; font-size: Theme.fs-md; font-weight: Theme.semibold; color: Theme.live-fg; horizontal-alignment: right; }
                }
                Text {
                    width: 130px;
                    text: root.item.langs;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-size: Theme.fs-xs;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            ta := TouchArea { clicked => { root.clicked(); } }
        }
    }
}

component ChannelLine inherits Rectangle {
    in property <SportsChannel> item;
    callback clicked();
    height: root.item.header ? 26px * Theme.density : 28px * Theme.density;
    border-radius: Theme.radius;
    background: !root.item.header && ta.has-hover ? Theme.row-hover : transparent;
    accessible-role: button;
    accessible-label: "Copy " + root.item.channel;
    if root.item.header: HorizontalLayout {
        padding-left: 8px;
        Text {
            text: root.item.text;
            font-size: Theme.fs-xs;
            font-weight: Theme.semibold;
            color: Theme.text-dim;
            vertical-alignment: bottom;
        }
    }
    if !root.item.header: HorizontalLayout {
        padding-left: 8px;
        Text { text: root.item.text; font-size: Theme.fs-md; color: Theme.text; vertical-alignment: center; overflow: elide; }
    }
    ta := TouchArea { enabled: !root.item.header; clicked => { root.clicked(); } }
}

// Search: filters the list as you type; Escape clears it.
component TeamSearch inherits Rectangle {
    callback done();
    min-width: 140px;
    preferred-width: 240px;
    max-width: 240px;
    horizontal-stretch: 1;
    height: 32px;
    background: Theme.input-bg;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: input.has-focus ? Theme.selected-border : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.search; tint: Theme.text-muted; size: 14px; }
        }
        input := TextInput {
            accessible-label: "Search events";
            text <=> SportsApi.search;
            color: Theme.text;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            single-line: true;
            edited => { SportsApi.search-edited(self.text); }
            accepted => { root.done(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    self.text = "";
                    SportsApi.search-edited("");
                    root.done();
                    return accept;
                }
                reject
            }
            if self.text == "" && !self.has-focus: Text {
                x: 0px;
                text: "Search";
                color: Theme.text-faint;
                font-size: Theme.fs-md;
                vertical-alignment: center;
                height: parent.height;
            }
        }
    }
}

export component SportsView inherits Rectangle {
    callback interacted();
    background: Theme.bg;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            spacing: 10px;
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                alignment: stretch;
                if SportsApi.sport-names.length > 1: Segmented {
                    width: SportsApi.sport-names.length * 80px;
                    options: SportsApi.sport-names;
                    current: SportsApi.sport;
                    changed(i) => { SportsApi.sport-picked(i); root.interacted(); }
                }
                if SportsApi.sport-names.length <= 1: Text { text: SportsApi.sport-names.length == 1 ? SportsApi.sport-names[0] : "Sports"; font-size: Theme.fs-xl; font-weight: Theme.semibold; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                TeamSearch { done => { root.interacted(); } }
                DButton { text: "Refresh"; clicked => { SportsApi.refresh(); root.interacted(); } }
            }
            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                Segmented {
                    width: 280px;
                    options: ["All", SportsApi.live-count > 0 ? "Live (" + SportsApi.live-count + ")" : "Live", "Upcoming"];
                    current: SportsApi.filter;
                    changed(i) => { SportsApi.filter-picked(i); root.interacted(); }
                }
                Text { text: SportsApi.status; font-size: Theme.fs-sm; color: Theme.text-muted; overflow: elide; horizontal-alignment: center; horizontal-stretch: 1; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    opacity: SportsApi.day-enabled ? 1.0 : 0.4;
                    DButton {
                        text: "‹";
                        label: "Previous day";
                        enabled: SportsApi.day-enabled && SportsApi.can-prev;
                        clicked => { SportsApi.day-step(-1); root.interacted(); }
                    }
                    Text {
                        width: 110px;
                        text: SportsApi.day-label;
                        font-size: Theme.fs-md;
                        font-weight: Theme.medium;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    DButton {
                        text: "›";
                        label: "Next day";
                        enabled: SportsApi.day-enabled && SportsApi.can-next;
                        clicked => { SportsApi.day-step(1); root.interacted(); }
                    }
                }
            }
            if SportsApi.rows.length == 0: Text {
                text: SportsApi.empty-text;
                font-size: Theme.fs-md;
                color: Theme.text-muted;
                vertical-stretch: 1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if SportsApi.rows.length > 0: sv := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: col.preferred-height;
                col := VerticalLayout {
                    for row[i] in SportsApi.rows: MatchRow {
                        item: row;
                        selected: i == SportsApi.cursor;
                        clicked => { SportsApi.row-selected(i); root.interacted(); }
                        reveal(y, h) => {
                            if (-sv.content-y > y) { sv.content-y = -y; }
                            else if (-sv.content-y + sv.visible-height < y + h) { sv.content-y = -(y + h - sv.visible-height); }
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.divider; }
        Rectangle {
            width: 340px;
            background: Theme.panel;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                if SportsApi.cursor < 0: Text {
                    text: "Select an event to see where it's on TV.";
                    color: Theme.text-muted;
                    font-size: Theme.fs-md;
                    wrap: word-wrap;
                }
                if SportsApi.cursor >= 0: Text {
                    text: SportsApi.detail-title;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.semibold;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if SportsApi.cursor >= 0: Text {
                    text: SportsApi.detail-sub;
                    font-size: Theme.fs-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if SportsApi.cursor >= 0 && SportsApi.channels.length == 0: Text {
                    text: "No channel listings found yet.";
                    font-size: Theme.fs-md;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if SportsApi.cursor >= 0 && SportsApi.channels.length > 0: ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: lines.preferred-height;
                    lines := VerticalLayout {
                        for ch[i] in SportsApi.channels: ChannelLine {
                            item: ch;
                            clicked => { SportsApi.channel-clicked(i); root.interacted(); }
                        }
                    }
                }
                if SportsApi.cursor < 0 || SportsApi.channels.length == 0: Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Languages are inferred from the country and channel name. Click a channel to copy its name. Listings come from free sources and may be incomplete.";
                    font-size: Theme.fs-xs;
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
            }
        }
    }
}
