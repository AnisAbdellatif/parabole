// Sports tab state. Rust: win.global::<SportsApi>(), src/slint_ui/sports/.
import { SportsRow, SportsChannel } from "types.slint";

export global SportsApi {
    // Enabled sports (Segmented options) and the current one.
    in property <[string]> sport-names;
    in property <int> sport;
    callback sport-picked(int);
    in property <[SportsRow]> rows;
    in property <int> cursor: -1;
    in property <string> detail-title;
    in property <string> detail-sub;
    in property <[SportsChannel]> channels;
    in property <string> status;
    in property <string> empty-text;
    callback row-selected(int);
    callback channel-clicked(int);
    callback refresh();
    in-out property <string> search;
    callback search-edited(string);
    // 0 all, 1 live, 2 upcoming.
    in property <int> filter;
    in property <int> live-count;
    callback filter-picked(int);
    in property <string> day-label;
    in property <bool> can-prev;
    in property <bool> can-next;
    // False while searching or showing live matches, which span every day.
    in property <bool> day-enabled: true;
    callback day-step(int);
    // Keys while the Sports tab is shown; return true when handled.
    callback key(KeyEvent) -> bool;
    key(e) => {
        if (e.text == Key.LeftArrow && root.day-enabled && root.can-prev) { root.day-step(-1); return true; }
        if (e.text == Key.RightArrow && root.day-enabled && root.can-next) { root.day-step(1); return true; }
        if (root.rows.length == 0) { return false; }
        if (e.text == Key.DownArrow) { root.row-selected(min(root.rows.length - 1, root.cursor + 1)); return true; }
        if (e.text == Key.UpArrow) { root.row-selected(max(0, root.cursor - 1)); return true; }
        if (e.text == Key.PageDown) { root.row-selected(min(root.rows.length - 1, root.cursor + 10)); return true; }
        if (e.text == Key.PageUp) { root.row-selected(max(0, root.cursor - 10)); return true; }
        if (e.text == Key.Home) { root.row-selected(0); return true; }
        if (e.text == Key.End) { root.row-selected(root.rows.length - 1); return true; }
        return false;
    }
}
