// Main window. Area ownership: docs/slint-phase2.md. Keys go Dialog -> Player -> Browse -> Core.
import { Theme } from "theme.slint";
import { Core } from "core.slint";
import { TopBar } from "topbar.slint";
import { Sidebar } from "sidebar.slint";
import { BrowseHost } from "browse-host.slint";
import { StatusBar } from "status-bar.slint";
import { Toasts } from "toasts.slint";
import { PlayerPane } from "player-pane.slint";
import { DialogHost } from "dialog-host.slint";
import { PlayerApi } from "player-api.slint";
import { BrowseApi } from "browse-api.slint";
import { DialogApi } from "dialog-api.slint";

export { Core, Theme, PlayerApi, BrowseApi, DialogApi }
export { StreamItem, SidebarItem, ToastItem, SourceRow, ProfileRow } from "types.slint";

export component AppWindow inherits Window {
    title: "IPTV Player";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: 13px;

    function move-cursor(d: int) { Core.cursor = max(0, min(Core.streams.length - 1, Core.cursor + d)); }
    init => { keys.focus(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (DialogApi.key(e) || PlayerApi.key(e) || BrowseApi.key(e)) { return accept; }
            if (e.modifiers.meta || e.modifiers.control) {
                if (e.text == "1") { Core.tab-selected(0); return accept; }
                if (e.text == "2") { Core.tab-selected(1); return accept; }
                if (e.text == "3") { Core.tab-selected(2); return accept; }
                if (e.text == "f") { top.focus-search(); return accept; }
            }
            if (e.text == Key.Escape) { Core.search-cleared(); keys.focus(); return accept; }
            if (e.text == Key.DownArrow) { root.move-cursor(1); return accept; }
            if (e.text == Key.UpArrow) { root.move-cursor(-1); return accept; }
            if (e.text == Key.PageDown) { root.move-cursor(12); return accept; }
            if (e.text == Key.PageUp) { root.move-cursor(-12); return accept; }
            if (e.text == Key.Home) { Core.cursor = 0; return accept; }
            if (e.text == Key.End) { Core.cursor = max(0, Core.streams.length - 1); return accept; }
            if (e.text == Key.Return) { Core.stream-activated(Core.cursor); return accept; }
            reject
        }
        VerticalLayout {
            top := TopBar { escaped => { keys.focus(); } }
            HorizontalLayout {
                Sidebar { }
                BrowseHost { interacted => { keys.focus(); } }
                PlayerPane { }
            }
            StatusBar { }
        }
    }

    DialogHost {
        width: parent.width;
        height: parent.height;
        closed => { keys.focus(); }
    }

    Toasts {
        x: parent.width - self.width - 16px;
        y: 0px;
        height: parent.height - Theme.statusbar-h - 16px;
    }
}
